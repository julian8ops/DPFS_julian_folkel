<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IBDb</title>
    <link rel="stylesheet" href="/stylesheets/body.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="nav-container">
        <div class="logo-container">
            <a href=""><img class="logo-container-logo" src="./images/IBDb_logo.png" alt="IBDb_logo"></a>
        </div>

        <ul class="nav-list">
            <li class="nav-button"><a class="nav-buttons" href="">All products</a></li>
            <li class="nav-button"><a class="nav-buttons" href="">About us</a></li>
            <li class="nav-button"><a class="nav-buttons" href="">Products</a></li>
            <li class="nav-button"><a class="nav-buttons" href="">Contact</a></li>
        </ul>
    </nav>

    <main>
        <div class="welcome-info">
            <h1 class="welcome-info-h1">
                Welcome to <p class="welcome-info-h1-p">IBDb</p>
            </h1>
            <div class="welcome-info">
                <p class="welcome-info-p">
                    Welcome to IBDb, your definitive guide to finding the best burger to eat today. 
                    We compare prices, ingredients, sizes and ratings of different restaurants, 
                    so you can make informed decisions. Discover the best options according to your preferences and budget, 
                    and share your experience with our community. Your perfect burger in just one click! 
                </p>
            </div>
            <div class="welcome-buttons">
                <a href="#">Login</a>
                <a href="#">Register</a>
            </div>
        </div>

        <div class="card-container">
            <a href="#" class="card-container-div-1"></a>
            <a href="#" class="card-container-div-2"></a>
            <a href="#" class="card-container-div-3"></a>
            <a href="#" class="card-container-div-4"></a>
        </div>

        <div class="comments-card">
            <p style="font-size: 25px;">Comments of people</p>
        </div>
        <div class="comments-section">
            <div></div>
            <div></div>
            <div></div>
        </div>
        <div class="contact-buttons">
            <p class="contact-us">Contact us</p>
            <p class="contact-p">Connect with us, help us make our page better</p>
        </div>
        <div class="contact-container">
            <form action="" class="contact-form"></form>
            <label for="Name"></label>
            <input class="input-comments" type="name" placeholder="Name">
            <label for="Email"></label>
            <input class="input-comments" type="email" placeholder="Email">
            <label for="Message"></label>
            <input class="input-comments-message"  type="message" placeholder="Message">
            <button class="button-comments">Send Message</button>
        </div>
        <br>
        <br>
        <footer>
            <div class="footer-container">
                <div class="link-container">
                    <a class="link-buttons" href="">About us</a>
                    <a class="link-buttons" href="">Products</a>
                </div>
                <div class="container-contact">
                    <ul>
                        <li class="contact-li-contact">Contact us:</li>
                        <li class="contact-li">Email:IBDb@gmail.com</li>
                        <li class="contact-li">Phone:0800-0000</li>
                    </ul>
                </div>
                <div class="social-container">
                    <a class="social-link-1" href="">Instagram</a>
                    <a class="social-link-2" href="">Facebook</a>
                    <a class="social-link-3" href="">X</a>
                </div>
            </div>
        </footer>
    </main>
</body>
</html>